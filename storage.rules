rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow read access to all files for anyone
    match /{allPaths=**} {
      allow read: if true;
    }
    
    // Allow write access to store images for authenticated users
    match /stores/{storeId}/{allImages=**} {
      allow write: if request.auth != null;
      
      // Validate file is an image and size is reasonable (< 5MB)
      allow create: if request.resource.contentType.matches('image/.*') 
                   && request.resource.size < 5 * 1024 * 1024;
    }
    
    // Allow write access to product images for authenticated users
    match /products/{storeId}/{productId}/{allImages=**} {
      allow write: if request.auth != null;
      
      // Validate file is an image and size is reasonable (< 5MB)
      allow create: if request.resource.contentType.matches('image/.*') 
                   && request.resource.size < 5 * 1024 * 1024;
    }
  }
} 